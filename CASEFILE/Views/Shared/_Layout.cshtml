
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CASEFILE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CASEFILE.styles.css" asp-append-version="true" />
</head>
<body class="casefile-body">

<div class="app-shell">

    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-icon">C</span>
            <span class="brand-name">CASEFILE</span>
        </a>

        <div class="sidebar-section">
            <span class="sidebar-heading">WORKSPACE</span>

            <a class="sidebar-link" asp-controller="Home" asp-action="Index">
                <span class="nav-icon">▦</span>
                Dashboard
            </a>

            <a class="sidebar-link" asp-controller="Cases" asp-action="Index">
                <span class="nav-icon">▤</span>
                Cases
            </a>

            <a class="sidebar-link" href="#">
                <span class="nav-icon">◎</span>
                People
            </a>

            <a class="sidebar-link" href="#">
                <span class="nav-icon">⬡</span>
                Evidence
            </a>
        </div>

        <div class="sidebar-section">
            <span class="sidebar-heading">INVESTIGATION</span>

            <a class="sidebar-link" href="#">
                <span class="nav-icon">⌁</span>
                Connections
            </a>

            <a class="sidebar-link" href="#">
                <span class="nav-icon">◷</span>
                Timeline
            </a>

            <a class="sidebar-link" href="#">
                <span class="nav-icon">▧</span>
                Reports
            </a>
        </div>

        <div class="sidebar-bottom">
            <div class="system-status">
                <span class="status-dot"></span>
                <span>System interface online</span>
            </div>

            <a class="sidebar-link" asp-controller="Home" asp-action="Privacy">
                <span class="nav-icon">⚙</span>
                Settings & Privacy
            </a>

            <div class="sidebar-version">
                CASEFILE <span>v0.1.0</span>
            </div>
        </div>
    </aside>

    <div class="main-area">
        <header class="topbar">
            <div class="breadcrumb-text">
                WORKSPACE <span>/</span> @ViewData["Title"]
            </div>

            <div class="topbar-right">
                <span class="environment-label">DEVELOPMENT</span>
                <div class="user-avatar">A</div>
                <div class="user-details">
                    <strong>Administrator</strong>
                    <span>Local workspace</span>
                </div>
            </div>
        </header>

        <main class="page-content">
            @RenderBody()
        </main>

        <footer class="app-footer">
            <span>CASEFILE © 2026</span>
            <span>Secure investigation workspace</span>
        </footer>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
