
@model CASEFILE.Models.Case

@{
    ViewData["Title"] = "Case Details";
}

<div class="dashboard">
    <section class="dashboard-heading">
        <div>
            <span class="eyebrow">WORKSPACE / CASE MANAGEMENT / CASE DETAILS</span>
            <h1>@Model.Title</h1>
            <p>Investigation reference: @Model.ReferenceNumber</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to cases
        </a>
    </section>

    <section class="dashboard-panel">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">INVESTIGATION RECORD</span>
                <h2>Case information</h2>
            </div>
        </div>

        <dl class="row">
            <dt class="col-sm-3">Reference number</dt>
            <dd class="col-sm-9">@Model.ReferenceNumber</dd>

            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "No description provided."
                    : Model.Description)
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</dd>

            <dt class="col-sm-3">Last updated</dt>
            <dd class="col-sm-9">
                @(Model.UpdatedAt.HasValue
                    ? Model.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm") + " UTC"
                    : "Never")
            </dd>
        </dl>
    </section>
</div>
